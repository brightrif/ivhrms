from django import forms

from apps.dependants.sponsor import FamilyVisaException

from apps.web.forms.dependants import DependantForm


class SponsoredDependantForm(DependantForm):
    """Add a family member for an employee who is already known: there is no employee box."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.fields.pop("employee", None)


class FamilyVisaExceptionForm(forms.Form):
    """HR or Management decide whether one person may have a family visa."""
    mode = forms.ChoiceField(
        label="Family visa for this person",
        choices=[(FamilyVisaException.Mode.DEFAULT, "Default (follow the designation)"),
                 (FamilyVisaException.Mode.ALLOWED, "Allowed"),
                 (FamilyVisaException.Mode.NOT_ALLOWED, "Not allowed")])
    reason = forms.CharField(
        required=False, label="Reason", widget=forms.Textarea(attrs={"rows": 3}),
        help_text="Needed for Allowed and Not allowed. It is kept with the change.")

    def __init__(self, *args, employee, **kwargs):
        super().__init__(*args, **kwargs)
        row = FamilyVisaException.objects.filter(employee=employee).first()
        self.initial.setdefault("mode", row.mode if row else FamilyVisaException.Mode.DEFAULT)
        if row:
            self.initial.setdefault("reason", row.reason)

    def clean(self):
        cd = super().clean()
        mode = cd.get("mode")
        reason = " ".join((cd.get("reason") or "").split())
        if mode in (FamilyVisaException.Mode.ALLOWED, FamilyVisaException.Mode.NOT_ALLOWED) and not reason:
            self.add_error("reason", "Give the reason.")
        cd["reason"] = reason
        return cd
