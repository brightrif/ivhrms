{% extends "web/base.html" %}
{% load bs %}
{% block title %}Loans{% endblock %}
{% block content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0">Payroll</h1>
  {% if perms.payroll.add_loan %}<a class="btn btn-primary" href="{% url 'web:payroll_loan_pick' %}"><i class="bi bi-plus-lg me-1"></i>New loan</a>{% endif %}
</div>
{% include "web/payroll/_tabs.html" with tab="loans" %}

<form method="get" class="row g-2 mb-3">
  <div class="col-md-4">
    <div class="input-group">
      <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
      <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Employee name or number">
    </div>
  </div>
  <div class="col-6 col-md-3">
    <select name="status" class="form-select" onchange="this.form.submit()">
      <option value="open"{% if status == 'open' %} selected{% endif %}>Open loans</option>
      <option value="all"{% if status == 'all' %} selected{% endif %}>Every loan</option>
      {% for value, label in statuses %}<option value="{{ value }}"{% if value == status %} selected{% endif %}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div>
</form>

<div class="card shadow-sm border-0"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>No.</th><th>Employee</th>{% if multi_company %}<th>Company</th>{% endif %}<th class="text-end">Amount</th><th class="text-end">Repaid</th><th class="text-end">Balance</th><th>Next deduction</th><th>Status</th></tr></thead>
    <tbody>
    {% for l in page %}
      <tr>
        <td class="text-nowrap"><a class="fw-medium text-decoration-none" href="{% url 'web:payroll_loan' l.pk %}">{{ l.number }}</a></td>
        <td>{{ l.employee.full_name }} <span class="small text-body-secondary">{{ l.employee.employee_no }}{% if l.employee.worker_type == 'labor' %}, labor{% endif %}</span>
            {% if l.kind == 'advance' %}<span class="badge text-bg-light border">Advance</span>{% endif %}</td>
        {% if multi_company %}<td>{{ l.company.code }}</td>{% endif %}
        <td class="text-end">{{ l.amount|floatformat:3 }}</td>
        <td class="text-end">{{ l.repaid_sum|floatformat:3 }}</td>
        <td class="text-end fw-medium">{{ l.balance_now|floatformat:3 }}</td>
        <td class="text-nowrap">{% if l.next_month %}{{ l.next_month|date:"M Y" }}{% else %}<span class="text-body-secondary">-</span>{% endif %}</td>
        <td><span class="badge {% if l.status == 'active' %}text-bg-success{% elif l.status == 'approved' %}text-bg-primary{% elif l.status == 'submitted' %}text-bg-warning{% elif l.status == 'closed' or l.status == 'cancelled' %}text-bg-secondary{% else %}text-bg-light border{% endif %}">{{ l.get_status_display }}</span></td>
      </tr>
    {% empty %}
      <tr><td colspan="8" class="text-center text-body-secondary py-4">No loans{% if q %} match that{% endif %}.{% if perms.payroll.add_loan %} Press "New loan" to add one.{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% if page.paginator.num_pages > 1 %}
<div class="card-footer bg-white d-flex justify-content-between align-items-center small">
  <span>Page {{ page.number }} of {{ page.paginator.num_pages }}</span>
  <span>
    {% if page.has_previous %}<a class="btn btn-sm btn-outline-secondary" href="?{{ extra }}&page={{ page.previous_page_number }}">Previous</a>{% endif %}
    {% if page.has_next %}<a class="btn btn-sm btn-outline-secondary" href="?{{ extra }}&page={{ page.next_page_number }}">Next</a>{% endif %}
  </span>
</div>
{% endif %}
</div>
{% endblock %}
