{% extends "web/base.html" %}
{% block title %}My attendance{% endblock %}
{% block content %}
<style>
  .att-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .att-dow div { font-size: .75rem; color: var(--bs-secondary-color); text-align: center; }
  .att-day { position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 68px;
             padding: .3rem .4rem; border-radius: .5rem; border: 1px solid var(--bs-border-color); background: var(--bs-body-bg);
             color: var(--bs-body-color); text-decoration: none; }
  .att-day:hover { border-color: var(--bs-primary); }
  .att-day.is-selected { outline: 2px solid var(--bs-primary); outline-offset: 1px; }
  .att-num { font-size: .75rem; color: var(--bs-secondary-color); }
  .att-today .att-num { display: inline-flex; align-items: center; justify-content: center; width: 1.25rem; height: 1.25rem;
                        border-radius: 50%; background: var(--bs-primary); color: #fff; font-weight: 600; }
  .att-mark { font-size: 1.05rem; font-weight: 600; text-align: center; line-height: 1; }
  .att-time { font-size: .65rem; color: var(--bs-secondary-color); text-align: center; min-height: .9rem; white-space: nowrap; }
  .att-dot { position: absolute; top: .35rem; right: .35rem; width: .5rem; height: .5rem; border-radius: 50%; background: var(--bs-warning); }
  .att-success { background: var(--bs-success-bg-subtle); color: var(--bs-success-text-emphasis); }
  .att-warning { background: var(--bs-warning-bg-subtle); color: var(--bs-warning-text-emphasis); }
  .att-info { background: var(--bs-info-bg-subtle); color: var(--bs-info-text-emphasis); }
  .att-danger { background: var(--bs-danger-bg-subtle); color: var(--bs-danger-text-emphasis); }
  .att-leave { background: color-mix(in srgb, var(--bs-purple) 14%, var(--bs-body-bg)); color: var(--bs-purple); }
  .att-off { background: var(--bs-tertiary-bg); color: var(--bs-secondary-color); }
  .att-none { border-style: dashed; }
  .att-future, .att-blank { opacity: .45; }
  .att-legend i { display: inline-block; width: 1.1rem; height: 1.1rem; line-height: 1.05rem; border-radius: .3rem; text-align: center;
                  font-size: .65rem; font-style: normal; font-weight: 600; margin-right: .35rem; border: 1px solid var(--bs-border-color); }
  @media (max-width: 575.98px) { .att-time { display: none; } .att-day { min-height: 50px; padding: .25rem .3rem; } .att-grid { gap: 3px; } }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0">Attendance <span class="text-body-secondary fw-normal">{{ month|date:"F Y" }}</span></h1>
  <div class="btn-group btn-group-sm" role="group" aria-label="Change month">
    <a class="btn btn-outline-secondary" href="?month={{ prev_month }}"><i class="bi bi-chevron-left"></i> Previous</a>
    {% if not is_this_month %}<a class="btn btn-outline-secondary" href="?month={{ this_month }}">This month</a>{% endif %}
    {% if next_month %}
      <a class="btn btn-outline-secondary" href="?month={{ next_month }}">Next <i class="bi bi-chevron-right"></i></a>
    {% else %}
      <span class="btn btn-outline-secondary disabled">Next <i class="bi bi-chevron-right"></i></span>
    {% endif %}
  </div>
</div>

<div class="row row-cols-2 row-cols-md-5 g-2 mb-3">
  <div class="col"><div class="card shadow-sm border-0"><div class="card-body py-2">
    <div class="small text-body-secondary">Worked</div><div class="fs-4 fw-semibold">{{ summary.worked }}</div></div></div></div>
  <div class="col"><div class="card shadow-sm border-0"><div class="card-body py-2">
    <div class="small text-body-secondary">Half days</div><div class="fs-4 fw-semibold">{{ summary.half }}</div></div></div></div>
  <div class="col"><div class="card shadow-sm border-0"><div class="card-body py-2">
    <div class="small text-body-secondary">Absent</div><div class="fs-4 fw-semibold">{{ summary.absent }}</div></div></div></div>
  <div class="col"><div class="card shadow-sm border-0"><div class="card-body py-2">
    <div class="small text-body-secondary">Leave</div><div class="fs-4 fw-semibold">{{ summary.leave }}</div></div></div></div>
  <div class="col"><div class="card shadow-sm border-0"><div class="card-body py-2">
    <div class="small text-body-secondary">Late</div><div class="fs-4 fw-semibold">{{ summary.late }}</div></div></div></div>
</div>

<div class="card shadow-sm border-0 mb-3"><div class="card-body">
  <div class="att-grid att-dow mb-1" aria-hidden="true">
    <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
  </div>
  <div class="att-grid" id="att-grid">
    {% for _ in lead %}<div></div>{% endfor %}
    {% for r in rows %}{% include "web/attendance/_day_tile.html" %}{% endfor %}
  </div>
  <div class="att-legend d-flex flex-wrap gap-3 small text-body-secondary mt-3">
    <span><i class="att-success">P</i>Present</span>
    <span><i class="att-warning">P</i>Late or left early</span>
    <span><i class="att-info">&frac12;</i>Half day</span>
    <span><i class="att-danger">A</i>Absent</span>
    <span><i class="att-leave">L</i>Leave</span>
    <span><i class="att-off">Off</i>Weekly off or holiday</span>
    <span><i class="att-none">?</i>No entry</span>
    <span><span class="d-inline-block rounded-circle bg-warning me-1" style="width:.55rem;height:.55rem"></span>Correction pending</span>
  </div>
</div></div>

<div id="day-panel" class="card shadow-sm border-0 mb-3" aria-live="polite">
  <div class="card-body">
    {% if pr %}{% include "web/attendance/_day_panel.html" %}
    {% else %}<div class="text-body-secondary"><i class="bi bi-hand-index me-1"></i>Select a day to see what was recorded and to ask for a correction.</div>{% endif %}
  </div>
</div>

<script>
  (function () {
    function select(iso) {
      var grid = document.getElementById("att-grid");
      if (!grid) return;
      grid.querySelectorAll(".att-day.is-selected").forEach(function (t) { t.classList.remove("is-selected"); });
      var tile = document.getElementById("att-day-" + iso);
      if (tile) tile.classList.add("is-selected");
    }
    document.addEventListener("click", function (e) {
      var a = e.target.closest("a.att-day");
      if (!a) return;
      select(a.id.replace("att-day-", ""));
    });
    document.body.addEventListener("htmx:afterSwap", function (e) {
      var t = e.detail && e.detail.target;
      if (t && t.id === "day-panel" && window.matchMedia("(max-width: 767.98px)").matches) {
        t.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });
  })();
</script>
{% endblock %}
