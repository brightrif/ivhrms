{% extends "web/base.html" %}
{% block title %}Add a family member{% endblock %}
{% block content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0">Staff</h1>
  <a class="btn btn-outline-secondary" href="{% url 'web:employee_family' %}">Back to list</a>
</div>
{% include "web/staff/_tabs.html" with tab="family" %}
{% include "web/family/_sections.html" with section="members" %}

<div class="card shadow-sm border-0 mb-3"><div class="card-body">
  <h2>Who is the sponsor?</h2>
  <p class="small text-body-secondary mb-2">Find the employee first. Only the best matches are listed, so the list never grows with the company.</p>
  <form method="get" hx-get="{% url 'web:employee_family_pick' %}" hx-trigger="input delay:300ms" hx-target="#results" hx-push-url="false">
    <div class="row">
      <div class="col-md-6 col-lg-5">
        <div class="input-group">
          <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
          <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Name or employee number" autofocus autocomplete="off">
        </div>
      </div>
    </div>
  </form>
</div></div>

<div id="results">{% include "web/family/_pick_results.html" %}</div>
{% endblock %}
