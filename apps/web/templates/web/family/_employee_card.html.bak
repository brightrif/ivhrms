{% if show %}
<div class="row g-3 mt-1">
  <div class="col-lg-4">
    <div class="card shadow-sm border-0 h-100"><div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h2>Family</h2>
        {% if can_add %}<a class="btn btn-sm btn-outline-primary" href="{% url 'web:employee_family_add' %}?employee={{ emp.pk }}&amp;next={{ next_url|urlencode }}"><i class="bi bi-plus-lg me-1"></i>Add family member</a>{% endif %}
      </div>
      {% if members %}
      <ul class="list-unstyled small mb-2">
        {% for m in members %}
        <li><a class="text-decoration-none" href="{% url 'web:employee_family_detail' m.pk %}">{{ m.full_name }}</a> <span class="text-body-secondary">{{ m.get_relationship_display }}</span></li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="small text-body-secondary mb-2">No family members recorded.</p>
      {% endif %}
      <div class="border-top pt-2 small">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <div>
            <span class="text-body-secondary">Family visa</span>
            {% if status.allowed %}<span class="badge text-bg-success ms-1">{{ status.text }}</span>{% else %}<span class="badge text-bg-secondary ms-1">{{ status.text }}</span>{% endif %}
          </div>
          {% if can_decide %}<a class="btn btn-sm btn-outline-secondary" href="{% url 'web:employee_family_visa_edit' emp.pk %}?next={{ next_url|urlencode }}">Change</a>{% endif %}
        </div>
        {% if status.reason %}<div class="text-body-secondary mt-1">{{ status.reason }}</div>{% endif %}
      </div>
    </div></div>
  </div>
</div>
{% endif %}
